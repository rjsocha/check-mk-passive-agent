[Unit]
Description=Checkmk passive agent receiver
After=network.target
ConditionPathExists=/etc/site/monitoring/agent/config.json

[Service]
Type=exec
User=wyga-check-mk-agentd
Group=wyga-check-mk-agentd
EnvironmentFile=-/etc/default/wyga-check-mk-agentd
LoadCredential=config:/etc/site/monitoring/agent/config.json
ExecStart=/usr/bin/wyga-check-mk-agentd
StateDirectory=monitoring/passive
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
