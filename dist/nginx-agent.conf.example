server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name agent.monitor.example.com;

  ssl_certificate     /etc/nginx/tls/agent.monitor.example.com.crt;
  ssl_certificate_key /etc/nginx/tls/agent.monitor.example.com.key;

  client_max_body_size 8m;

  auth_basic           "[agent]";
  auth_basic_user_file /etc/site/monitoring/agent.htpasswd;

  location = /push-agent/passive {
    proxy_pass http://127.0.0.1:8611;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location /push-agent/passive/ {
    proxy_pass http://127.0.0.1:8611;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location / {
    return 404;
  }
}
